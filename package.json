{
  "name": "acurioustale.de",
  "private": true,
  "type": "module",
  "description": "Lint tooling for the acurioustale.de landing page. The site itself has no build step; this only provides ESLint and markdownlint-cli2, which are npm-only.",
  "author": "Markus Spitzner",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"css/**/*.css\"",
    "lint:md": "markdownlint-cli2",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:md",
    "links": "lychee --config lychee.toml index.html README.md CLAUDE.md SECURITY.md .well-known/security.txt",
    "validate": "./validate.sh",
    "test": "node --test",
    "coverage": "node --test --experimental-test-coverage --test-coverage-exclude='test/**' --test-coverage-exclude='tools/shared/**/*.test.js' --test-coverage-exclude='js/terminal.js' --test-coverage-exclude='js/theme-toggle.js' --test-coverage-lines=100 --test-coverage-branches=100 --test-coverage-functions=100",
    "test:e2e": "playwright test",
    "check:csp": "node tools/check-csp.mjs",
    "check:og": "node tools/check-og-image.mjs",
    "check:asset-refs": "node tools/check-asset-refs.mjs",
    "check:deploy-assets": "node tools/check-deploy-assets.mjs",
    "check:security-txt": "node tools/check-security-txt-expiry.mjs",
    "check:stale-overrides": "node tools/check-stale-overrides.mjs",
    "check:shared": "node tools/check-shared.mjs",
    "shared:hash": "node tools/check-shared.mjs --write"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/json": "^2.1.0",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.10.0",
    "eslint-plugin-html": "^8.2.0",
    "fast-check": "^4.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "svgo": "^4.0.1",
    "vnu-jar": "^26.9.7"
  },
  "overrides": {
    "smol-toml": "^1.7.1"
  }
}
